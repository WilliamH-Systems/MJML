<mjml>
  <mj-head>
    <mj-preview>{{preview}}</mj-preview>
    <mj-title>Broadband Intelligence // AMCC + Systems</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" />
    <mj-font name="JetBrains Mono" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

    <mj-attributes>
      <mj-all font-family="'Inter', sans-serif" color="#ffffff" />
      <mj-text font-size="16px" line-height="26px" font-weight="300" />
    </mj-attributes>

    <mj-style inline="inline">
      .content-wrapper {
        background-color: #0b1329 !important;
        border-radius: 12px !important;
        box-shadow: 0px 10px 40px rgba(0, 0, 0, 0.5) !important;
      }
      .terminal {
        background-color: #000000 !important;
        border-left: 4px solid #3b82f6 !important;
        border-radius: 4px !important;
      }
      .bold-title {
        font-weight: 800 !important;
        letter-spacing: -1px !important;
      }
      .app-bg {
        background-color: #3c6eb4 !important;
        background: linear-gradient(180deg, #3c6eb4 30%, #3c95b4 90%) !important;
      }
    </mj-style>

    <mj-style>
      .fluid-container {
        max-width: 94% !important;
        width: 94% !important;
      }
      @media only screen and (max-width: 680px) {
        .fluid-container {
          max-width: 92% !important;
          width: 92% !important;
        }
        .content-wrapper {
          padding: 25px 20px !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body css-class="app-bg">
    <mj-wrapper background-color="#3c6eb4" padding="0">
      <mj-section css-class="fluid-container" padding-top="40px" padding-bottom="40px">
        <mj-column css-class="content-wrapper" padding="40px 32px">

          <mj-text font-family="'JetBrains Mono', monospace" font-size="11px" color="#94a3b8" letter-spacing="3px">
            {{meta}}
          </mj-text>
          <mj-text font-size="36px" line-height="42px" css-class="bold-title" padding-top="10px" padding-bottom="20px">
            {{title}} <br/><span style="color: #60a5fa;">{{subtitle}}</span>
          </mj-text>

          <!--SECTIONS-->

          <mj-button background-color="#3b82f6" color="#ffffff" font-weight="600" border-radius="4px" href="{{cta_url}}" align="left" padding-top="20px">
            {{cta_label}}
          </mj-button>

          <mj-text align="center" font-family="'JetBrains Mono', monospace" font-size="10px" color="#475569" padding-top="40px">
            {{footer}}
          </mj-text>

        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
